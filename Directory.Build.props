<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <Deterministic>true</Deterministic>
    <!-- Catalan is the neutral (base) language of every resource file (arquitectura-base, D8) -->
    <NeutralLanguage>ca</NeutralLanguage>
    <Version>0.1.0-dev</Version>
    <Authors>Guillermo Garcia Carballo</Authors>
    <Copyright>Copyright (c) 2026 Guillermo Garcia Carballo</Copyright>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
  </PropertyGroup>
</Project>
