<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>Arca.Desktop</RootNamespace>
    <AssemblyName>Arca</AssemblyName>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- The icon of the executable in Windows, from the one master in assets/icon (icona-d-aplicacio). -->
    <ApplicationIcon>..\..\assets\icon\arca.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <ProjectReference Include="..\Arca.Application\Arca.Application.csproj" />
    <ProjectReference Include="..\Arca.Infrastructure\Arca.Infrastructure.csproj" />
    <ProjectReference Include="..\Arca.UI\Arca.UI.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The end-to-end test builds the start screen over a real database with the composition of the application -->
    <InternalsVisibleTo Include="Arca.UI.Tests" />
  </ItemGroup>
</Project>
