root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{csproj,props,targets,json,yml,yaml,axaml,xml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.cs]
# Naming: PascalCase types and members, _camelCase private fields, Async suffix (docs/convenciones.md)
dotnet_naming_rule.private_fields_underscore.symbols = private_fields
dotnet_naming_rule.private_fields_underscore.style = underscore_camel
dotnet_naming_rule.private_fields_underscore.severity = warning
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_style.underscore_camel.required_prefix = _
dotnet_naming_style.underscore_camel.capitalization = camel_case

csharp_style_namespace_declarations = file_scoped:warning
dotnet_style_qualification_for_field = false:suggestion
csharp_using_directive_placement = outside_namespace:warning
dotnet_sort_system_directives_first = true

# Every source file carries the licence header (docs/convenciones.md)
file_header_template = SPDX-License-Identifier: GPL-3.0-or-later\nCopyright (c) 2026 Guillermo Garcia Carballo
dotnet_diagnostic.IDE0073.severity = warning

# ARCA is an application, not a public library: these API-design rules would force names the conventions reject
# (Error, Result<T>.Success) without helping any consumer.
dotnet_diagnostic.CA1716.severity = none
dotnet_diagnostic.CA1000.severity = none
# Key material and the key-file model are byte arrays by nature (serialisation, libsodium); an immutable wrapper would only copy them
dotnet_diagnostic.CA1819.severity = none

[tests/**.cs]
# Test names describe the scenario with underscores (docs/convenciones.md)
dotnet_diagnostic.CA1707.severity = none
# Test data arrays are throwaway, and some tests call ToString() on purpose to prove it ignores the current culture
dotnet_diagnostic.CA1861.severity = none
dotnet_diagnostic.CA1305.severity = none
# Tests are short-lived: passing the runner cancellation token everywhere adds noise
dotnet_diagnostic.xUnit1051.severity = none
# Sample handlers in tests are instance types on purpose: the rule under test looks at instance methods
dotnet_diagnostic.CA1822.severity = none

[src/Arca.Infrastructure/Storage/Migrations/*.cs]
# Generated by 'dotnet ef migrations add'; reviewed in each change but not restyled by hand
generated_code = true
